# Drone Commander MK2 — local environment template
# Copy to .env and fill in API keys before running docker compose.
# Ports differ from MK1 so both stacks can run side by side.

DATABASE_URL=postgresql+psycopg://drone:drone@postgres:5432/drone_commander_mk2
LLM_PROVIDER=openai
LLM_EXTERNAL_ENABLED=true
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
LLM_MODEL_TACTICAL=gpt-5.6-luna
LLM_MODEL_RADIO=gpt-5.6-luna
LLM_DECISION_TIMEOUT_SEC=20

# Local Jev / TypeSafe tactical-provider test configuration.
# Paste the TypeSafe key only into your local .env; never commit a real key.
# jev-latest is resolved through GET /v1/models at startup. The choice response
# records the concrete model id. Radio stays on the template while Jev is the
# tactical provider unless RADIO_PROVIDER=openai.
# TACTICAL_SHADOW=true logs Jev's choice but commits the deterministic fallback.
# Live Jev confidence on this account was about 0.18, so a local test may set
# JEV_MIN_CONFIDENCE and JEV_MIN_MARGIN to 0. The defaults below stay conservative.
TYPESAFE_API_KEY=
TYPESAFE_BASE_URL=https://api.typesafe.ai
TYPESAFE_MODEL=jev-latest
TACTICAL_PROVIDER=openai
TACTICAL_SHADOW=false
RADIO_PROVIDER=auto
JEV_DECISION_TIMEOUT_SEC=3
JEV_MIN_CONFIDENCE=0.60
JEV_MIN_MARGIN=0.10
LOG_LEVEL=INFO
# metadata | full_diagnostic
ARTIFACT_RETENTION_MODE=metadata
VITE_API_BASE=http://localhost:8006
